        "review_1": {
          "type": "review",
          "settings": {
            "author": "Emily R.",
            "rating": 5,
            "text": "I poured it into an old ceramic bowl and it looked absolutely stunning. So easy to set up — literally took 30 seconds. The flame is calm and clean, no smoke at all.",
            "verified": true
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "author": "Sarah L.",
            "rating": 5,
            "text": "Bought this as a gift for my sister and she was obsessed. The candle sand concept is genius — you can reuse the same bowl forever. Way better than regular candles.",
            "verified": true
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "author": "Tom K.",
            "rating": 5,
            "text": "Used it in a glass jar on my dinner table. Looks designer-level honestly. Burns clean, lasts long, and you can just add more sand when it runs low. Will buy again.",
            "verified": true
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "author": "Jessica M.",
            "rating": 4,
            "text": "Really cool concept. I love that it's eco-friendly and unscented so I can add my own oils. Shipping was fast too. Only wish the bag was a bit bigger!",
            "verified": true
          }
        },
        "review_5": {
          "type": "review",
          "settings": {
            "author": "Anna G.",
            "rating": 5,
            "text": "I've reused 4 containers already — old mugs, a vase, a coconut shell. This stuff just works. Clean burn, no mess, and it feels so satisfying to make your own candle.",
            "verified": true
          }
        }
